# ═══════════════════════════════════════════════════════════════════════════
#  .env.example — Plantilla de variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  Este archivo SÍ puede subirse a Git (sin datos sensibles).
# ═══════════════════════════════════════════════════════════════════════════
 
# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=academic_user
POSTGRES_PASSWORD=AcademicDB_S3cure_2024!
POSTGRES_DB=academic_db
POSTGRES_PORT=5432
 
# ── n8n ─────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8nAdmin_S3cure_2024!
# Clave de cifrado: mínimo 32 caracteres, generada aleatoriamente
N8N_ENCRYPTION_KEY=AcademicN8N_EncKey_32Chars_2024!!
N8N_PORT=5678
N8N_HOST=localhost
 
# ── Zona horaria ─────────────────────────────────────────────────────────────
TIMEZONE=America/Guatemala
 
# ── Adminer ──────────────────────────────────────────────────────────────────
ADMINER_PORT=8080
 
# ── Mailhog ──────────────────────────────────────────────────────────────────
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
MH_AUTH_FILE = -auth-file=/ruta/al/archivo/mailhog.auth
 
# Web App
WEB_PORT=3000
 
COMPOSE_PROJECT_NAME=automatizacion
